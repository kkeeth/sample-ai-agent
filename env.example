# ---------------------------------------------------------------
# 1. このファイルを .env にコピー   →  cp env.example .env
# 2. 運営から配られたキーを貼る
# 3. 疎通確認                        →  bun run check
# ---------------------------------------------------------------

# Anthropic API を直接使う場合（合宿ではたいていこちら）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Claude Platform on AWS を使う場合は、上をコメントアウトしてこちらを使う ---
# AWS_REGION=us-east-1
# ANTHROPIC_AWS_WORKSPACE_ID=xxxxxxxx
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
